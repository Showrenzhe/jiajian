{
  "name": "jiajian",
  "productName": "佳剪",
  "version": "0.9.0",
  "author": "Showrenzhe",
  "repository": "github:Showrenzhe/jiajian",
  "private": true,
  "description": "本地分镜混剪与媒体处理工作台",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.cjs\"",
    "test:desktop": "node test/run-desktop.cjs",
    "test:cloud-desktop": "electron test/cloud-desktop.cjs",
    "bench:frames": "node test/run-interaction-frames.cjs",
    "bench:large": "node test/run-interaction-frames.cjs --large",
    "test:updates": "node --test test/app-updates.test.cjs && electron test/software-update-desktop.cjs",
    "dist:win": "electron-builder --config electron-builder.cjs --win nsis --x64 --publish never",
    "test:smoke": "node test/run-desktop.cjs --smoke",
    "test:full": "npm test && npm run test:desktop",
    "lint": "eslint src scripts test",
    "typecheck": "tsc --project tsconfig.json",
    "format": "prettier --write",
    "format:check": "prettier --check .prettierrc.json tsconfig.json eslint.config.cjs package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "semver": "7.8.6"
  }
}
